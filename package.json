    "packageManager": "bun@1.3.9",
    "scripts": {
        "dick:all": "bunx nx format:check && bunx nx run-many -t lint,test,build",
        "dick:downloads": "bunx nx format:check --projects=downloads && bunx nx run-many -t lint,test,build -p downloads",
        "dick:admin": "bunx nx format:check --projects=e-coop-admin && bunx nx run-many -t lint,test,build -p e-coop-admin",
        "dick:core": "bunx nx format:check --projects=e-coop-core && bunx nx run-many -t lint,test,build -p e-coop-core",
        "dick:member": "bunx nx format:check --projects=e-coop-member && bunx nx run-many -t lint,test,build -p e-coop-member",
        "prep": "husky",
        "gen-mod": "bunx plop module-gen",
        "unused": "knip",
        "dev:downloads": "bunx nx serve downloads",
        "bld:downloads": "bunx nx build downloads",
        "st:downloads": "bunx serve apps/downloads/dist -l 3000 --single",
        "dev:admin": "bunx nx serve e-coop-admin",
        "bld:admin": "bunx nx build e-coop-admin",
        "st:admin": "bunx serve apps/e-coop-admin/dist -l 3001 --single",
        "dev:core": "bunx nx serve e-coop-core",
        "bld:core": "bunx nx build e-coop-core",
        "st:core": "bunx serve apps/e-coop-core/dist -l 3002 --single",
        "dev:member": "bunx nx serve e-coop-member",
        "bld:member": "bunx nx build e-coop-member",
        "st:member": "bunx serve apps/e-coop-member/dist -l 3003 --single",
        "fc": "prettier . -c",
        "fcf": "prettier -c",
        "fw": "prettier . -w",
        "fwf": "prettier -w",
        "lint": "eslint .",
        "el": "eslint .",
        "lf": "eslint .",
        "elf": "eslint . --fix",
        "fmt": "eslint . --fix && prettier . -w",
        "test": "vitest run .",
        "testw": "vitest",
        "preview": "vite preview --port $PORT --host",
        "pwa-test": "bun run build && bun run preview",
        "build": "tsc -b && vite build",
        "vc": "eslint . && prettier . -c && vitest run && tsc -b --verbose && vite build",
        "validate:all": "bun run fmt && bun run vc"
    },
